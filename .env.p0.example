# CK-NEXUS P0 staging environment. Copy to /secure/path/cknexus-p0.env (mode 600).
COMPOSE_PROJECT_NAME=cknexus-p0
CKNEXUS_ENVIRONMENT=staging
POSTGRES_IMAGE=postgres:16-alpine
N8N_IMAGE=n8nio/n8n:2.32.6
REDIS_IMAGE=redis:7-alpine
CKNEXUS_DB_PASSWORD=replace-with-long-random-secret
N8N_DB_PASSWORD=replace-with-long-random-secret
N8N_ENCRYPTION_KEY=replace-with-at-least-32-random-bytes
CKNEXUS_ACCESS_TOKEN=replace-with-long-random-token
CKNEXUS_EMAIL_WEBHOOK_TOKEN=replace-with-long-random-token
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# CK-NEXUS Development Council (5 specialist advisers + lead orchestrator)
CKNEXUS_DEV_TEAM_ENABLED=true
CKNEXUS_DEV_TEAM_WEB_SEARCH=true
CKNEXUS_DEV_TEAM_MAX_TURNS=8
# Optional per-adviser model overrides. Empty = use OPENAI_MODEL.
CKNEXUS_MODEL_ARCHITECT=
CKNEXUS_MODEL_RESEARCH=
CKNEXUS_MODEL_DESIGNER=
CKNEXUS_MODEL_BUILDER=
CKNEXUS_MODEL_REVIEWER=
CKNEXUS_EMAIL_LEASE_SECONDS=300
CKNEXUS_PORT=8000
N8N_PORT=5678
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_WEBHOOK_URL=http://127.0.0.1:5678/
TZ=Asia/Bangkok
CKNEXUS_EVIDENCE_ROOT=/var/tmp/cknexus-evidence
# Required for ZIP-only staging when .git is unavailable. Prefer a real immutable Git SHA.
CKNEXUS_SOURCE_COMMIT=
# Optional GitHub integration for staging evidence.
GITHUB_TOKEN=
GITHUB_REPO=
GITHUB_API_BASE=https://api.github.com

# Integration Hub
SLACK_BOT_TOKEN=
GOOGLE_DRIVE_ACCESS_TOKEN=
N8N_BASE_URL=
N8N_API_KEY=
CKNEXUS_INTEGRATION_TIMEOUT_SECONDS=5
