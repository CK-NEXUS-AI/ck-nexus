{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ck-nexus.local/schemas/recovery/backup-manifest.schema.json",
  "title": "CK-NEXUS Backup Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["backup_id", "created_at", "environment", "consistency", "objects", "verification_state"],
  "properties": {
    "backup_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "environment": {"type": "string"},
    "tenant_scope": {"type": ["string", "null"]},
    "source_subject": {"type": ["string", "null"]},
    "consistency": {"type": "string", "enum": ["CRASH_CONSISTENT", "TRANSACTION_CONSISTENT", "APPLICATION_COORDINATED", "SNAPSHOT", "LOGICAL_EXPORT", "MIXED"]},
    "objects": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["name", "kind", "digest"], "properties": {"name": {"type": "string"}, "kind": {"type": "string"}, "digest": {"type": "string"}, "size_bytes": {"type": ["integer", "null"], "minimum": 0}}, "additionalProperties": true}},
    "excluded_components": {"type": "array", "items": {"type": "string"}},
    "tool_versions": {"type": "object"},
    "verification_state": {"type": "string", "enum": ["DIGEST_ONLY", "FORMAT_VALIDATED", "RESTORE_TESTED", "BUSINESS_VERIFIED", "BLOCKED", "FAILED"]},
    "retention_class": {"type": ["string", "null"]},
    "metadata": {"type": "object"}
  }
}