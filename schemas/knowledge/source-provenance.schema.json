{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ck-nexus.local/schemas/knowledge/source-provenance.schema.json",
  "title": "CK-NEXUS Source Provenance",
  "type": "object",
  "additionalProperties": false,
  "required": ["source_kind", "source_ref", "observed_at", "producer"],
  "properties": {
    "source_kind": {"type": "string", "enum": ["owner_input", "connected_service", "public_documentation", "provider_output", "execution_evidence", "imported_file", "marketplace_artifact", "derived_summary"]},
    "source_ref": {"type": "string", "minLength": 1},
    "source_hash": {"type": ["string", "null"]},
    "observed_at": {"type": "string", "format": "date-time"},
    "published_at": {"type": ["string", "null"], "format": "date-time"},
    "producer": {"type": "string", "minLength": 1},
    "producer_version": {"type": ["string", "null"]},
    "transformation_chain": {"type": "array", "items": {"type": "string"}},
    "license_note": {"type": ["string", "null"]},
    "evidence_refs": {"type": "array", "items": {"type": "string"}}
  }
}