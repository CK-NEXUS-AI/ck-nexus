{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ck-nexus.local/schemas/cognitive/worker-scorecard.schema.json",
  "title": "CK-NEXUS Cognitive Worker Scorecard",
  "type": "object",
  "additionalProperties": false,
  "required": ["scorecard_id", "implementation_id", "capability_id", "evidence_level", "observed_at", "sample_count", "metrics"],
  "properties": {
    "scorecard_id": {"type": "string"},
    "implementation_id": {"type": "string"},
    "capability_id": {"type": "string"},
    "task_profile": {"type": ["string", "null"]},
    "evidence_level": {"type": "string", "enum": ["UNMEASURED", "SYNTHETIC_EVAL", "SHADOW_OBSERVED", "CANARY_OBSERVED", "PRODUCTION_OBSERVED"]},
    "observed_at": {"type": "string", "format": "date-time"},
    "fresh_until": {"type": ["string", "null"], "format": "date-time"},
    "sample_count": {"type": "integer", "minimum": 0},
    "metrics": {"type": "object", "additionalProperties": {"type": "number", "minimum": 0, "maximum": 1}},
    "latency_ms_p50": {"type": ["number", "null"], "minimum": 0},
    "latency_ms_p95": {"type": ["number", "null"], "minimum": 0},
    "cost_per_verified_task": {"type": ["number", "null"], "minimum": 0},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "dataset_ref": {"type": ["string", "null"]},
    "evidence_refs": {"type": "array", "items": {"type": "string"}}
  }
}