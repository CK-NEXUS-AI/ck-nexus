{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ck-nexus.local/schemas/observability/slo-status.schema.json",
  "title": "CK-NEXUS SLO Status",
  "type": "object",
  "additionalProperties": false,
  "required": ["slo_id", "tenant_scope", "environment", "window_start", "window_end", "objective", "state", "observed_at"],
  "properties": {
    "slo_id": {"type": "string", "minLength": 1},
    "tenant_scope": {"type": "string", "minLength": 1},
    "environment": {"type": "string", "minLength": 1},
    "window_start": {"type": "string", "format": "date-time"},
    "window_end": {"type": "string", "format": "date-time"},
    "objective": {"type": "number", "minimum": 0, "maximum": 1},
    "observed_value": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "sample_count": {"type": ["integer", "null"], "minimum": 0},
    "error_budget_remaining": {"type": ["number", "null"]},
    "state": {"type": "string", "enum": ["HEALTHY", "AT_RISK", "BREACHED", "INSUFFICIENT_DATA", "UNKNOWN"]},
    "observed_at": {"type": "string", "format": "date-time"},
    "fresh_until": {"type": ["string", "null"], "format": "date-time"},
    "evidence_refs": {"type": "array", "items": {"type": "string"}},
    "metadata": {"type": "object"}
  }
}