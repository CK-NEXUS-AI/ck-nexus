{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ck-nexus.local/schemas/fabric/reconciliation-record.schema.json",
  "title": "CK-NEXUS Reconciliation Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["reconciliation_id", "tenant_id", "object_kind", "object_id", "observed_at", "classification", "sources", "resolution"],
  "properties": {
    "reconciliation_id": {"type": "string", "minLength": 1},
    "tenant_id": {"type": "string", "minLength": 1},
    "object_kind": {"type": "string", "enum": ["connector", "capability", "skill", "memory", "provider", "workflow", "external_side_effect"]},
    "object_id": {"type": "string", "minLength": 1},
    "observed_at": {"type": "string", "format": "date-time"},
    "classification": {"type": "string", "enum": ["MATCH", "LIVE_NEWER", "CACHE_ONLY", "LIVE_ONLY", "MALFORMED", "CONFLICT", "STALE", "UNKNOWN_COMMIT_STATE"]},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_kind", "source_ref"],
        "properties": {
          "source_kind": {"type": "string"},
          "source_ref": {"type": "string"},
          "observed_hash": {"type": ["string", "null"]},
          "freshness_ms": {"type": ["integer", "null"], "minimum": 0}
        }
      }
    },
    "resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state"],
      "properties": {
        "state": {"type": "string", "enum": ["ACCEPT_LIVE", "ACCEPT_CK", "QUARANTINE", "REAUTH_REQUIRED", "MANUAL_REVIEW", "NO_CHANGE"]},
        "authoritative_ref": {"type": ["string", "null"]},
        "reason_codes": {"type": "array", "items": {"type": "string"}}
      }
    },
    "evidence_refs": {"type": "array", "items": {"type": "string"}},
    "metadata": {"type": "object"}
  }
}