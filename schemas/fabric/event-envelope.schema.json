{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ck-nexus.local/schemas/fabric/event-envelope.schema.json",
  "title": "CK-NEXUS Fabric Event Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "event_type",
    "event_version",
    "occurred_at",
    "producer",
    "correlation_id",
    "payload_schema",
    "payload"
  ],
  "properties": {
    "event_id": {"type": "string", "minLength": 8},
    "event_type": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
    "event_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
    "occurred_at": {"type": "string", "format": "date-time"},
    "recorded_at": {"type": "string", "format": "date-time"},
    "producer": {"type": "string", "minLength": 1},
    "tenant_id": {"type": ["string", "null"]},
    "principal_id": {"type": ["string", "null"]},
    "session_id": {"type": ["string", "null"]},
    "execution_id": {"type": ["string", "null"]},
    "correlation_id": {"type": "string", "minLength": 1},
    "causation_id": {"type": ["string", "null"]},
    "trace_id": {"type": ["string", "null"]},
    "ordering_key": {"type": ["string", "null"]},
    "idempotency_key": {"type": ["string", "null"]},
    "data_classification": {"type": ["string", "null"]},
    "payload_schema": {"type": "string", "minLength": 1},
    "payload": {},
    "evidence_refs": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "policy_context_ref": {"type": ["string", "null"]},
    "metadata": {"type": "object", "additionalProperties": true}
  }
}