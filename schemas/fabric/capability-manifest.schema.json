{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ck-nexus.local/schemas/fabric/capability-manifest.schema.json",
  "title": "CK-NEXUS Capability Manifest",
  "type": "object",
  "additionalProperties": true,
  "required": ["id", "version", "type", "display_name", "lifecycle", "capabilities"],
  "properties": {
    "id": {"type": "string", "minLength": 3, "pattern": "^[a-z0-9][a-z0-9._-]+$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$"},
    "type": {
      "type": "string",
      "enum": ["provider", "connector", "tool", "skill", "agent", "workflow", "verifier", "storage", "policy"]
    },
    "display_name": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "owner": {"type": "string"},
    "lifecycle": {
      "type": "string",
      "enum": ["experimental", "candidate", "canary", "stable", "deprecated", "disabled", "quarantined", "revoked"]
    },
    "capabilities": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/capability"}
    },
    "auth": {"$ref": "#/$defs/auth"},
    "events": {"$ref": "#/$defs/events"},
    "health": {"type": "object", "additionalProperties": true},
    "trust": {"type": "object", "additionalProperties": true},
    "contracts": {"type": "object", "additionalProperties": true},
    "metadata": {"type": "object", "additionalProperties": true}
  },
  "$defs": {
    "capability": {
      "type": "object",
      "additionalProperties": true,
      "required": ["description", "risk", "side_effect", "input_schema", "output_schema"],
      "properties": {
        "description": {"type": "string", "minLength": 1},
        "risk": {
          "type": "string",
          "enum": ["READ_ONLY", "LOW", "MEDIUM", "HIGH", "CRITICAL"]
        },
        "side_effect": {
          "type": "string",
          "enum": ["NONE", "LOCAL_REVERSIBLE", "EXTERNAL_REVERSIBLE", "EXTERNAL_MUTATION", "DESTRUCTIVE", "FINANCIAL", "PRODUCTION_CONTROL"]
        },
        "input_schema": {"type": "string", "minLength": 1},
        "output_schema": {"type": "string", "minLength": 1},
        "idempotent": {"oneOf": [{"type": "boolean"}, {"type": "string", "enum": ["conditional"]}]},
        "approval": {"type": "string"},
        "evidence": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "data_classifications": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "timeout_ms": {"type": "integer", "minimum": 1},
        "cost": {"type": "object", "additionalProperties": true},
        "quota": {"type": "object", "additionalProperties": true}
      }
    },
    "auth": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "schemes": {
          "type": "array",
          "items": {"type": "string", "enum": ["oauth2", "api_key", "service_account", "github_app", "workload_identity", "mtls", "local_socket", "none"]},
          "uniqueItems": true
        },
        "secret_exposure": {"type": "string", "enum": ["forbidden"]}
      }
    },
    "events": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "produces": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "consumes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    }
  }
}