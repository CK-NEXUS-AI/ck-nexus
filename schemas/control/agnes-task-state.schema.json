{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ck-nexus.local/schemas/control/agnes-task-state.schema.json",
  "title": "CK-NEXUS AGNES Task State",
  "type": "object",
  "additionalProperties": false,
  "required": ["task_id", "tenant_id", "state", "version", "created_at", "nodes"],
  "properties": {
    "task_id": {"type": "string"},
    "tenant_id": {"type": "string"},
    "state": {"type": "string", "enum": ["CREATED", "PLANNING", "READY", "RUNNING", "PAUSED", "VERIFYING", "SUCCEEDED", "FAILED", "CANCEL_REQUESTED", "CANCELLED", "BLOCKED_POLICY", "BLOCKED_APPROVAL", "BLOCKED_DEPENDENCY", "SECURITY_VETO", "UNKNOWN"]},
    "version": {"type": "integer", "minimum": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": ["string", "null"], "format": "date-time"},
    "plan_hash": {"type": ["string", "null"]},
    "nodes": {"type": "array", "items": {"type": "object", "required": ["node_id", "capability_id", "state"], "properties": {"node_id": {"type": "string"}, "capability_id": {"type": "string"}, "state": {"type": "string"}, "decision_ref": {"type": ["string", "null"]}, "approval_ref": {"type": ["string", "null"]}, "receipt_ref": {"type": ["string", "null"]}, "attempts": {"type": "integer", "minimum": 0}}, "additionalProperties": true}},
    "evidence_refs": {"type": "array", "items": {"type": "string"}},
    "metadata": {"type": "object"}
  }
}