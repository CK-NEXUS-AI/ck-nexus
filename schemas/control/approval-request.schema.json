{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ck-nexus.local/schemas/control/approval-request.schema.json",
  "title": "CK-NEXUS Approval Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["approval_id", "tenant_id", "requester_id", "capability_id", "target_fingerprint", "plan_hash", "risk", "side_effect", "environment", "policy_hash", "approval_class", "state", "created_at", "expires_at"],
  "properties": {
    "approval_id": {"type": "string", "minLength": 1},
    "tenant_id": {"type": "string", "minLength": 1},
    "requester_id": {"type": "string", "minLength": 1},
    "capability_id": {"type": "string", "minLength": 1},
    "target_fingerprint": {"type": "string", "minLength": 8},
    "plan_hash": {"type": "string", "minLength": 8},
    "risk": {"type": "string", "enum": ["READ_ONLY", "LOW", "MEDIUM", "HIGH", "CRITICAL"]},
    "side_effect": {"type": "string"},
    "environment": {"type": "string"},
    "policy_hash": {"type": "string", "minLength": 8},
    "approval_class": {"type": "string", "enum": ["NONE", "OPERATOR", "ADMIN", "OWNER", "DUAL_CONTROL"]},
    "state": {"type": "string", "enum": ["REQUESTED", "PENDING", "APPROVED", "REJECTED", "EXPIRED", "REVOKED", "CONSUMED", "SUPERSEDED"]},
    "created_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "max_cost": {"type": ["number", "null"], "minimum": 0},
    "max_attempts": {"type": ["integer", "null"], "minimum": 1},
    "approver_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "evidence_refs": {"type": "array", "items": {"type": "string"}},
    "metadata": {"type": "object"}
  }
}