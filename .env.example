# CK-NEXUS Creator Edition
# Copy this file to .env.local. Never commit .env.local.

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
# Disabled by default: model/tool payloads stay out of OpenAI trace export unless explicitly enabled.
CKNEXUS_OPENAI_TRACING_ENABLED=false

# R7 Provider Router — local/mock first with bounded fallback.
CKNEXUS_PROVIDER_LOCAL_FIRST=true
CKNEXUS_PROVIDER_ALLOW_CLOUD=true
CKNEXUS_PROVIDER_MAX_ATTEMPTS=3
CKNEXUS_PROVIDER_FAILURE_THRESHOLD=2
CKNEXUS_PROVIDER_CIRCUIT_COOLDOWN_SECONDS=30
CKNEXUS_PROVIDER_TIMEOUT_SECONDS=90

# R8 encrypted credential vault. Generate the key outside source control.
CKNEXUS_VAULT_ENABLED=false
CKNEXUS_VAULT_PATH=data/credential-vault.db
CKNEXUS_VAULT_KEY=

# Optional local Ollama provider. Keep loopback-only.
CKNEXUS_OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=

# Credit Guard / Free Fallback policy.
# When a trusted telemetry source reports remaining credit <= 85%, CK-NEXUS latches FREE_ONLY.
# Sticky=true means the mode survives restart until an explicit operator reset.
# Remote free tiers are disabled by default because third-party pricing can change;
# the durable zero-API-credit fallback is local Ollama/self-hosted execution.
CKNEXUS_FREE_FALLBACK_REMAINING_PCT=85
CKNEXUS_FREE_FALLBACK_STICKY=true
CKNEXUS_FREE_ONLY_ALLOW_REMOTE=false
CKNEXUS_LLM_STATE_PATH=data/llm-keypool-state.json
CKNEXUS_FREE_FALLBACK_STATE_PATH=data/free-fallback-policy.json

# Universal Credit Telemetry Fabric.
# Unknown or unsupported provider credit is recorded as UNKNOWN and is never guessed.
CKNEXUS_CREDIT_TELEMETRY_INTERVAL_SEC=300
CKNEXUS_CREDIT_TELEMETRY_EVIDENCE_PATH=data/credit-telemetry.jsonl
# OpenRouter /api/v1/credits requires a management key. Keep it server-side only.
OPENROUTER_MANAGEMENT_KEY=
# OpenAI Costs API requires an organization admin key plus an explicit budget basis.
OPENAI_ADMIN_KEY=
CKNEXUS_OPENAI_MONTHLY_BUDGET_USD=

# CK-NEXUS Development Council (5 specialist advisers + lead orchestrator)
CKNEXUS_DEV_TEAM_ENABLED=true
CKNEXUS_DEV_TEAM_WEB_SEARCH=true
CKNEXUS_DEV_TEAM_MAX_TURNS=8
# Optional per-adviser model overrides. Empty = use OPENAI_MODEL.
CKNEXUS_MODEL_ARCHITECT=
CKNEXUS_MODEL_RESEARCH=
CKNEXUS_MODEL_DESIGNER=
CKNEXUS_MODEL_BUILDER=
CKNEXUS_MODEL_REVIEWER=

# true = safe local demonstration without an API call
# false = use the OpenAI Agents SDK and OPENAI_API_KEY
CKNEXUS_MOCK_AI=true

CKNEXUS_DATABASE_PATH=data/cknexus.db
# Optional: absolute working directory when launching the installed `ck-nexus` command elsewhere.
CKNEXUS_HOME=
CKNEXUS_HOST=127.0.0.1
PORT=8000

# Recommended when binding to a non-loopback address.
CKNEXUS_ACCESS_TOKEN=

CKNEXUS_MAX_PROMPT_CHARS=8000
CKNEXUS_HISTORY_LIMIT=30
CKNEXUS_RATE_LIMIT_PER_MINUTE=10
CKNEXUS_RUN_TIMEOUT_SECONDS=90
CKNEXUS_MAX_REQUEST_BYTES=65536

# Optional Codex Bridge for trusted, local software-engineering tasks.
# Keep disabled until Codex CLI is installed, authenticated, and an access token is set.
CKNEXUS_CODEX_ENABLED=false
CKNEXUS_CODEX_BIN=codex
# Optional writable Codex state/auth directory (useful in containers).
CKNEXUS_CODEX_HOME=
CKNEXUS_CODEX_WORKSPACE=
# Allowed values: read-only, workspace-write. danger-full-access is rejected.
CKNEXUS_CODEX_SANDBOX=read-only
CKNEXUS_CODEX_TIMEOUT_SECONDS=600
CKNEXUS_CODEX_MAX_OUTPUT_CHARS=100000

# P0 Email Gateway (disabled by default)
CKNEXUS_EMAIL_GATEWAY_ENABLED=false
CKNEXUS_EMAIL_DATABASE_PATH=data/cknexus.db
CKNEXUS_EMAIL_WEBHOOK_TOKEN=change-me-before-enabling
CKNEXUS_EMAIL_LEASE_SECONDS=300
CKNEXUS_EMAIL_DATABASE_URL=

# Optional GitHub integration. Never commit a real token.
GITHUB_TOKEN=
# owner/repository, for example: your-account/ck-nexus
GITHUB_REPO=
GITHUB_API_BASE=https://api.github.com

# Integration Hub (server-side only; never expose these in browser code)
SLACK_BOT_TOKEN=
SLACK_API_BASE=https://slack.com/api
GOOGLE_DRIVE_ACCESS_TOKEN=
GOOGLE_DRIVE_API_BASE=https://www.googleapis.com/drive/v3
CKNEXUS_INTEGRATION_TIMEOUT_SECONDS=5

# Gmail OAuth (server-side authorization code flow).
# Client values are secrets/configuration and must live only in the protected runtime env/vault.
CKNEXUS_GMAIL_OAUTH_ENABLED=false
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=
CKNEXUS_GMAIL_SEND_ENABLED=false

# GitHub App authentication (preferred over long-lived PAT for automation).
CKNEXUS_GITHUB_APP_ENABLED=false
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_API_VERSION=2026-03-10

# R9 canonical gateway (non-secret behavior plus secret references)
CKN_ENV=development
CKN_POLICY_VERSION=2026-08-09.1
CKN_AUDIT_REQUIRED=true
CKNEXUS_GATEWAY_PORT=8080
CKNEXUS_REDIS_URL=redis://127.0.0.1:6379/0
CKNEXUS_JWT_ISSUER=ck-nexus
CKNEXUS_JWT_ALGORITHM=RS256
# CKNEXUS_JWT_PUBLIC_KEY is runtime secret/config material; do not commit a real key.
CKNEXUS_JWT_PUBLIC_KEY=

# AGNES Skill Nervous System (local-first; does not consume user API keys)
CKNEXUS_AGNES_ENABLED=true
CKNEXUS_AGNES_LEDGER_PATH=data/agnes-ledger.jsonl
CKNEXUS_AGNES_MAX_PARALLEL_SKILLS=5

# AGNES Execution Kernel Phase 2 (disabled by default)
CKNEXUS_AGNES_SANDBOX_ENABLED=false
CKNEXUS_AGNES_SANDBOX_ROOT=data/agnes-sandbox
CKNEXUS_AGNES_SANDBOX_REPOSITORY_ROOT=

# AGNES Execution Kernel Phase 3 (development candidate; disabled by default)
CKNEXUS_AGNES_PHASE3_ENABLED=false
# Phase 3 requires CKNEXUS_AGNES_SANDBOX_ENABLED=true.
# Production-safe cgroup v2 requires a delegated writable cgroup tree.
# Set this to the delegated subtree, not the host root, when systemd/container delegation is used.
CKNEXUS_AGNES_CGROUP_ROOT=/sys/fs/cgroup
# Distributed idempotency requires a live Redis or PostgreSQL backend.

# Distributed AGNES Phase 3 idempotency (required in staging/production when Phase 3 is enabled)
CKNEXUS_AGNES_REDIS_URL=

# R28 Universal Auto Connector Fabric (disabled by default)
# Register MCP/OpenAPI endpoints, discover schemas, and expose verified read-only tools.
CKNEXUS_CONNECTOR_FABRIC_ENABLED=false
CKNEXUS_CONNECTOR_REGISTRY_PATH=data/connector-registry.json
CKNEXUS_CONNECTOR_EVIDENCE_PATH=data/connector-evidence.jsonl
CKNEXUS_CONNECTOR_TIMEOUT_SECONDS=8
