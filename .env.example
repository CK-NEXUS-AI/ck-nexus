# CK-NEXUS Creator Edition
# Copy this file to .env.local. Never commit .env.local.

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# R7 Provider Router — local/mock first with bounded fallback.
CKNEXUS_PROVIDER_LOCAL_FIRST=true
CKNEXUS_PROVIDER_ALLOW_CLOUD=true
CKNEXUS_PROVIDER_MAX_ATTEMPTS=3
CKNEXUS_PROVIDER_FAILURE_THRESHOLD=2
CKNEXUS_PROVIDER_CIRCUIT_COOLDOWN_SECONDS=30
CKNEXUS_PROVIDER_TIMEOUT_SECONDS=90

# Optional local Ollama provider. Keep loopback-only.
CKNEXUS_OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=

# CK-NEXUS Development Council (5 specialist advisers + lead orchestrator)
CKNEXUS_DEV_TEAM_ENABLED=true
CKNEXUS_DEV_TEAM_WEB_SEARCH=true
CKNEXUS_DEV_TEAM_MAX_TURNS=8
# Optional per-adviser model overrides. Empty = use OPENAI_MODEL.
CKNEXUS_MODEL_ARCHITECT=
CKNEXUS_MODEL_RESEARCH=
CKNEXUS_MODEL_DESIGNER=
CKNEXUS_MODEL_BUILDER=
CKNEXUS_MODEL_REVIEWER=

# true = safe local demonstration without an API call
# false = use the OpenAI Agents SDK and OPENAI_API_KEY
CKNEXUS_MOCK_AI=true

CKNEXUS_DATABASE_PATH=data/cknexus.db
# Optional: absolute working directory when launching the installed `ck-nexus` command elsewhere.
CKNEXUS_HOME=
CKNEXUS_HOST=127.0.0.1
PORT=8000

# Recommended when binding to a non-loopback address.
CKNEXUS_ACCESS_TOKEN=

CKNEXUS_MAX_PROMPT_CHARS=8000
CKNEXUS_HISTORY_LIMIT=30
CKNEXUS_RATE_LIMIT_PER_MINUTE=10
CKNEXUS_RUN_TIMEOUT_SECONDS=90
CKNEXUS_MAX_REQUEST_BYTES=65536

# Optional Codex Bridge for trusted, local software-engineering tasks.
# Keep disabled until Codex CLI is installed, authenticated, and an access token is set.
CKNEXUS_CODEX_ENABLED=false
CKNEXUS_CODEX_BIN=codex
# Optional writable Codex state/auth directory (useful in containers).
CKNEXUS_CODEX_HOME=
CKNEXUS_CODEX_WORKSPACE=
# Allowed values: read-only, workspace-write. danger-full-access is rejected.
CKNEXUS_CODEX_SANDBOX=read-only
CKNEXUS_CODEX_TIMEOUT_SECONDS=600
CKNEXUS_CODEX_MAX_OUTPUT_CHARS=100000

# P0 Email Gateway (disabled by default)
CKNEXUS_EMAIL_GATEWAY_ENABLED=false
CKNEXUS_EMAIL_DATABASE_PATH=data/cknexus.db
CKNEXUS_EMAIL_WEBHOOK_TOKEN=change-me-before-enabling
CKNEXUS_EMAIL_LEASE_SECONDS=300
CKNEXUS_EMAIL_DATABASE_URL=

# Optional GitHub integration. Never commit a real token.
GITHUB_TOKEN=
# owner/repository, for example: your-account/ck-nexus
GITHUB_REPO=
GITHUB_API_BASE=https://api.github.com

# Integration Hub (server-side only; never expose these in browser code)
SLACK_BOT_TOKEN=
SLACK_API_BASE=https://slack.com/api
GOOGLE_DRIVE_ACCESS_TOKEN=
GOOGLE_DRIVE_API_BASE=https://www.googleapis.com/drive/v3
N8N_BASE_URL=
N8N_API_KEY=
CKNEXUS_INTEGRATION_TIMEOUT_SECONDS=5

# Gmail OAuth (server-side authorization code flow).
# Client values are secrets/configuration and must live only in the protected runtime env/vault.
CKNEXUS_GMAIL_OAUTH_ENABLED=false
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=
CKNEXUS_GMAIL_SEND_ENABLED=false

# GitHub App authentication (preferred over long-lived PAT for automation).
CKNEXUS_GITHUB_APP_ENABLED=false
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_API_VERSION=2026-03-10
