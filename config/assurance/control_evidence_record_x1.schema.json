{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ck-nexus/control-evidence-record-x1",
  "title": "CK-NEXUS Control Evidence Record X1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "evidence_id",
    "control_id",
    "subject",
    "source",
    "observed_at",
    "result",
    "verification_state"
  ],
  "properties": {
    "evidence_id": {"type": "string", "minLength": 1},
    "control_id": {"type": "string", "pattern": "^X1-[0-9]{2}$"},
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {"type": ["string", "null"]},
        "commit": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
        "tree": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
        "artifact": {"type": ["string", "null"]},
        "artifact_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "source": {"type": "string", "minLength": 1},
    "observed_at": {"type": "string", "format": "date-time"},
    "tool_or_reviewer": {"type": ["string", "null"]},
    "result": {"type": "string", "minLength": 1},
    "evidence_uri": {"type": ["string", "null"]},
    "sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "freshness": {"type": ["string", "null"]},
    "verification_state": {
      "type": "string",
      "enum": [
        "PLANNED",
        "IMPLEMENTED",
        "MEASURED_NOT_VERIFIED",
        "EXTERNALLY_REVIEWED",
        "VERIFIED",
        "BLOCKED",
        "NOT_APPLICABLE"
      ]
    },
    "supersedes": {"type": ["string", "null"]},
    "notes": {"type": ["string", "null"]}
  }
}
