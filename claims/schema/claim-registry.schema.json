{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ck-nexus.local/schemas/claim-registry.schema.json",
  "title": "CK-NEXUS Claim Registry Entry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "claim_id",
    "claim_text_th",
    "category",
    "state",
    "created_by",
    "subject",
    "benchmark",
    "evidence",
    "verifier",
    "state_history",
    "created_at"
  ],
  "properties": {
    "claim_id": {
      "type": "string",
      "pattern": "^CLAIM-[A-Z0-9_]+-[0-9]{3}$"
    },
    "claim_text_th": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "type": "string",
      "enum": [
        "mobile-first",
        "offline",
        "recovery",
        "thai-first",
        "approval-ux",
        "voice-persona",
        "security",
        "performance"
      ]
    },
    "state": {
      "type": "string",
      "enum": [
        "TARGET",
        "MEASURED_NOT_VERIFIED",
        "VERIFIED",
        "REJECTED"
      ]
    },
    "created_by": {
      "type": "string",
      "minLength": 1
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "component", "environment"],
      "properties": {
        "commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "component": {
          "type": "string",
          "minLength": 1
        },
        "environment": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "benchmark": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "protocol_ref": {
          "type": "string",
          "minLength": 1
        },
        "harness_commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "layers_completed": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "core_baseline",
              "local_api",
              "llamacpp_local_inference",
              "agnes_integrated_offline"
            ]
          }
        },
        "runs": {
          "type": "integer",
          "minimum": 0
        },
        "aggregation": {
          "type": ["string", "null"],
          "enum": ["median", "worst_case", null]
        },
        "measurement_method": {
          "type": ["string", "null"]
        },
        "measurement_limitations": {
          "type": ["string", "null"]
        }
      }
    },
    "evidence": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "evidence_path": {
          "type": "string",
          "minLength": 1
        },
        "evidence_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "exit_code": {
          "type": "integer"
        },
        "output_digest": {
          "type": "string",
          "minLength": 1
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "verifier": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "verified_by": {
          "type": "string",
          "minLength": 1
        },
        "verified_at": {
          "type": "string",
          "format": "date-time"
        },
        "verdict_reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "state_history": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from_state", "to_state", "at", "reason"],
        "properties": {
          "from_state": {
            "type": ["string", "null"],
            "enum": [
              "TARGET",
              "MEASURED_NOT_VERIFIED",
              "VERIFIED",
              "REJECTED",
              null
            ]
          },
          "to_state": {
            "type": "string",
            "enum": [
              "TARGET",
              "MEASURED_NOT_VERIFIED",
              "VERIFIED",
              "REJECTED"
            ]
          },
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
