CKNEXUS_ENVIRONMENT=staging
CKNEXUS_DB_PASSWORD=CHANGE_ME_RANDOM
CKNEXUS_ACCESS_TOKEN=CHANGE_ME_RANDOM
CKNEXUS_EMAIL_WEBHOOK_TOKEN=CHANGE_ME_RANDOM
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol

# R7 Provider Router — local/mock first with bounded fallback.
CKNEXUS_PROVIDER_LOCAL_FIRST=true
CKNEXUS_PROVIDER_ALLOW_CLOUD=true
CKNEXUS_PROVIDER_MAX_ATTEMPTS=3
CKNEXUS_PROVIDER_FAILURE_THRESHOLD=2
CKNEXUS_PROVIDER_CIRCUIT_COOLDOWN_SECONDS=30
CKNEXUS_PROVIDER_TIMEOUT_SECONDS=90

# R8 encrypted credential vault. Required in production when Gmail OAuth or GitHub App is enabled.
CKNEXUS_VAULT_ENABLED=false
CKNEXUS_VAULT_PATH=data/credential-vault.db
CKNEXUS_VAULT_KEY=

# Optional local Ollama provider. Keep loopback-only.
CKNEXUS_OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=

# CK-NEXUS Development Council (5 specialist advisers + lead orchestrator)
CKNEXUS_DEV_TEAM_ENABLED=true
CKNEXUS_DEV_TEAM_WEB_SEARCH=true
CKNEXUS_DEV_TEAM_MAX_TURNS=8
# Optional per-adviser model overrides. Empty = use OPENAI_MODEL.
CKNEXUS_MODEL_ARCHITECT=
CKNEXUS_MODEL_RESEARCH=
CKNEXUS_MODEL_DESIGNER=
CKNEXUS_MODEL_BUILDER=
CKNEXUS_MODEL_REVIEWER=
CKNEXUS_PORT=8000
TZ=Asia/Bangkok

# Optional GitHub integration; set these only in the protected runtime env.
GITHUB_TOKEN=
GITHUB_REPO=
GITHUB_API_BASE=https://api.github.com

# Integration Hub
SLACK_BOT_TOKEN=
GOOGLE_DRIVE_ACCESS_TOKEN=
CKNEXUS_INTEGRATION_TIMEOUT_SECONDS=5

# Gmail OAuth (server-side authorization code flow).
# Client values are secrets/configuration and must live only in the protected runtime env/vault.
CKNEXUS_GMAIL_OAUTH_ENABLED=false
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=
CKNEXUS_GMAIL_SEND_ENABLED=false

# GitHub identity portal OAuth App (identity verification only; no repository write scope).
# Register callback: https://YOUR_HOST/api/identity/github/callback
CKNEXUS_GITHUB_OAUTH_ENABLED=false
CKNEXUS_GITHUB_OAUTH_CLIENT_ID=
CKNEXUS_GITHUB_OAUTH_CLIENT_SECRET=
CKNEXUS_GITHUB_OAUTH_REDIRECT_URI=

# GitHub App authentication (preferred over long-lived PAT for automation).
CKNEXUS_GITHUB_APP_ENABLED=false
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_API_VERSION=2026-03-10

# Distributed AGNES Phase 3 idempotency (required in staging/production when Phase 3 is enabled)
CKNEXUS_AGNES_REDIS_URL=

# R28 Universal Auto Connector Fabric. Keep disabled until connector policy is reviewed.
CKNEXUS_CONNECTOR_FABRIC_ENABLED=false
CKNEXUS_CONNECTOR_REGISTRY_PATH=data/connector-registry.json
CKNEXUS_CONNECTOR_EVIDENCE_PATH=data/connector-evidence.jsonl
CKNEXUS_CONNECTOR_TIMEOUT_SECONDS=8
