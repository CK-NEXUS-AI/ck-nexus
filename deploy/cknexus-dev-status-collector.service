[Unit]
Description=CK-NEXUS read-only development status collector
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=cknexus-creator
WorkingDirectory=/opt/ck-nexus-src
Environment=CKNEXUS_DEV_STATUS_FILE=/opt/ck-nexus-src/data/dev_status.json
ExecStart=/usr/bin/python3 /opt/ck-nexus-src/scripts/collect_dev_status.py
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ReadWritePaths=/opt/ck-nexus-src/data
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0027
