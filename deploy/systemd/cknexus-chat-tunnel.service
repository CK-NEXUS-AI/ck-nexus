[Unit]
Description=CK-NEXUS Chat-only Cloudflare HTTPS Quick Tunnel
After=network-online.target cknexus-chat-ingress.service
Wants=network-online.target
Requires=cknexus-chat-ingress.service

[Service]
Type=simple
DynamicUser=yes
Environment=HOME=/var/lib/cknexus-chat-tunnel
StateDirectory=cknexus-chat-tunnel
StateDirectoryMode=0700
ExecStart=/usr/local/bin/cloudflared tunnel --no-autoupdate --url http://127.0.0.1:8102
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
UMask=0077

[Install]
WantedBy=multi-user.target
