# CK-NEXUS Universal System — Post-P0 development additions
# Copy only the variables you actually need into a protected local environment.
# Never commit real credentials.

# Gmail OAuth / Google credential aliases used by the Post-P0 helpers.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# AI provider credentials.
OPENAI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
MOONSHOT_API_KEY=
MISTRAL_API_KEY=
TOGETHER_API_KEY=
SAMBANOVA_API_KEY=
ZHIPU_API_KEY=
DASHSCOPE_API_KEY=
OPENROUTER_API_KEY=
CEREBRAS_API_KEY=

# GitHub App development aliases. Prefer the canonical CK-NEXUS broker names
# where both are supported. Do not commit generated installation tokens.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_INSTALLATION_ID=
GITHUB_INSTALLATION_TOKEN=

# Credential / provider behavior.
CREDIT_WARNING_THRESHOLD_PERCENT=95
CREDIT_ROTATION_THRESHOLD_PERCENT=5
PROVIDER_RETRY_DELAY_SEC=300
PROVIDER_MAX_RETRY_ATTEMPTS=5

# Fail-closed security defaults.
SECURITY_FAIL_CLOSED=true
SECURITY_REDACT_SECRETS=true

# Auto-connect development manager.
HEALTH_CHECK_INTERVAL_SEC=30
MAX_RETRY_ATTEMPTS=5
CIRCUIT_BREAKER_THRESHOLD=3
CIRCUIT_COOLDOWN_SEC=60
OFFLINE_MODE_ENABLED=true

# Multi-provider development priority.
LLM_PROVIDER_PRIORITY_1=groq
LLM_PROVIDER_PRIORITY_2=openrouter
LLM_PROVIDER_PRIORITY_3=openai
LLM_PROVIDER_PRIORITY_4=anthropic
LLM_PROVIDER_PRIORITY_5=deepseek
