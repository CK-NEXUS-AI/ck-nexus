[Unit]
Description=CK-NEXUS n8n Development Intelligence collector
After=network-online.target n8n.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
WorkingDirectory=/root/ck-nexus
ExecStart=/usr/bin/python3 -m ops.vps.scripts.cknexus_n8n_intelligence
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ReadOnlyPaths=/root/ck-nexus /root/.config/n8n/api_key
ReadWritePaths=/var/lib/cknexus/n8n-intelligence /root/.local/state/cknexus
Environment=N8N_INTEL_BASE_URL=https://xtzsfd91.rpcld.co/api/v1
Environment=N8N_INTEL_DATABASE=/var/lib/cknexus/n8n-intelligence/events.db
Environment=CKNEXUS_TASK_DATABASE=/root/.local/state/cknexus/control-plane.sqlite3
Environment=N8N_INTEL_MAX_EXECUTIONS=50
Environment=N8N_INTEL_SLOW_SECONDS=30

[Install]
WantedBy=multi-user.target
