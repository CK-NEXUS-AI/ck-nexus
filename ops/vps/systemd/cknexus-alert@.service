[Unit]
Description=CK-NEXUS deduplicated local alert for failed unit %i

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStart=/usr/local/sbin/cknexus-service-alert %i
NoNewPrivileges=true
PrivateTmp=true
RuntimeDirectory=cknexus-alert
RuntimeDirectoryMode=0700
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log/cknexus /run/cknexus-alert
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
