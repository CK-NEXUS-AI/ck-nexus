#!/usr/bin/env python3
"""Narrow privileged wrapper for CK-NEXUS read-only browser automation."""
from __future__ import annotations

import ipaddress
import re
import subprocess
import sys
import tempfile
from urllib.parse import urlsplit

HELPER = "/usr/local/bin/cknexus-browser"
ALLOWED_HOSTS = {
    "github.com",
    "docs.github.com",
    "raw.githubusercontent.com",
    "progressive-clouds-sellers-cube.trycloudflare.com",
    "commodity-reveal-flexible-catalog.trycloudflare.com",
}
ACTIONS = {"status", "open", "text", "title", "url", "screenshot"}
SCREENSHOT_PATH_PATTERN = re.compile(
    re.escape(tempfile.gettempdir()) + r"/cknexus-browser-mcp-[0-9]+\.png"
)


def valid_url(value: str) -> bool:
    if not value or len(value) > 2048:
        return False
    try:
        parsed = urlsplit(value)
        host = (parsed.hostname or "").lower().rstrip(".")
        if parsed.scheme != "https" or parsed.username is not None or parsed.password is not None:
            return False
        if parsed.port not in (None, 443) or host not in ALLOWED_HOSTS:
            return False
        try:
            if not ipaddress.ip_address(host).is_global:
                return False
        except ValueError:
            pass
        return True
    except ValueError:
        return False


def main() -> int:
    if len(sys.argv) != 2 or sys.argv[1] not in ACTIONS:
        print("Denied browser action.", file=sys.stderr)
        return 2
    action = sys.argv[1]
    helper_args = [HELPER, action]
    input_value = None
    if action in {"open", "screenshot"}:
        input_value = sys.stdin.readline(2049)
        if not input_value.endswith("\n"):
            print("Invalid browser input.", file=sys.stderr)
            return 2
        value = input_value[:-1]
        if action == "open" and not valid_url(value):
            print("Denied URL.", file=sys.stderr)
            return 2
        if action == "screenshot" and not SCREENSHOT_PATH_PATTERN.fullmatch(value):
            print("Denied screenshot path.", file=sys.stderr)
            return 2
    try:
        result = subprocess.run(
            helper_args,
            input=input_value,
            capture_output=True,
            text=True,
            timeout=32,
            check=False,
            shell=False,
            close_fds=True,
        )
    except (OSError, subprocess.TimeoutExpired):
        print("Browser helper unavailable or timed out.", file=sys.stderr)
        return 3
    if result.stdout:
        print(result.stdout[:14000], end="" if result.stdout.endswith("\n") else "\n")
    if result.returncode and result.stderr:
        print(result.stderr[:1000], file=sys.stderr)
    return result.returncode

if __name__ == "__main__":
    raise SystemExit(main())
