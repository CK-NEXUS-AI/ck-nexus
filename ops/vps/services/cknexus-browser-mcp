#!/usr/bin/env python3
"""Narrow privileged wrapper for CK-NEXUS read-only browser automation."""

from __future__ import annotations

import base64
import ipaddress
import json
import stat
import subprocess
import sys
import tempfile
from pathlib import Path
from urllib.parse import urlsplit

HELPER = "/usr/local/bin/cknexus-browser"
PRIVATE_TMP_ROOT = "/run"
ALLOWED_HOSTS = {
    "github.com",
    "docs.github.com",
    "raw.githubusercontent.com",
    "progressive-clouds-sellers-cube.trycloudflare.com",
    "commodity-reveal-flexible-catalog.trycloudflare.com",
}
ACTIONS = {"status", "open", "text", "title", "url", "screenshot"}


def valid_url(value: str) -> bool:
    if not value or len(value) > 2048:
        return False
    try:
        parsed = urlsplit(value)
        host = (parsed.hostname or "").lower().rstrip(".")
        if parsed.scheme != "https" or parsed.username is not None or parsed.password is not None:
            return False
        if parsed.port not in (None, 443) or host not in ALLOWED_HOSTS:
            return False
        try:
            if not ipaddress.ip_address(host).is_global:
                return False
        except ValueError:
            pass
        return True
    except ValueError:
        return False


def _capture_screenshot() -> int:
    """Capture under a root-private directory; never accept a caller path."""
    try:
        with tempfile.TemporaryDirectory(
            prefix="cknexus-browser-mcp-", dir=PRIVATE_TMP_ROOT
        ) as private_dir:
            screenshot_path = Path(private_dir) / "capture.png"
            result = subprocess.run(
                [HELPER, "screenshot", str(screenshot_path)],
                capture_output=True,
                text=True,
                timeout=32,
                check=False,
                shell=False,
            )
            if result.returncode:
                if result.stderr:
                    print(result.stderr[:1000], file=sys.stderr)
                return result.returncode
            file_stat = screenshot_path.lstat()
            if not stat.S_ISREG(file_stat.st_mode):
                print("Browser screenshot output is not a regular file.", file=sys.stderr)
                return 3
            try:
                helper_payload = json.loads(result.stdout) if result.stdout.strip() else {}
            except json.JSONDecodeError:
                helper_payload = {"helper_result": result.stdout[:4000]}
            payload = helper_payload if isinstance(helper_payload, dict) else {}
            image_bytes = screenshot_path.read_bytes()
            payload["screenshot_base64"] = base64.b64encode(image_bytes).decode("ascii")
            payload["screenshot_mime_type"] = "image/png"
            print(json.dumps(payload, separators=(",", ":")))
            return 0
    except (OSError, ValueError, TypeError, subprocess.TimeoutExpired):
        print("Browser screenshot capture failed safely.", file=sys.stderr)
        return 3


def main() -> int:
    if len(sys.argv) < 2 or sys.argv[1] not in ACTIONS:
        print("Denied browser action.", file=sys.stderr)
        return 2
    action = sys.argv[1]
    expected = 3 if action == "open" else 2
    if len(sys.argv) != expected:
        print("Invalid browser arguments.", file=sys.stderr)
        return 2
    if action == "open" and not valid_url(sys.argv[2]):
        print("Denied URL.", file=sys.stderr)
        return 2
    if action == "screenshot":
        return _capture_screenshot()
    args = [HELPER, action]
    if action == "open":
        args.append(sys.argv[2])
    try:
        result = subprocess.run(
            args,
            capture_output=True,
            text=True,
            timeout=32,
            check=False,
            shell=False,
        )
    except (OSError, subprocess.TimeoutExpired):
        print("Browser helper unavailable or timed out.", file=sys.stderr)
        return 3
    if result.stdout:
        print(result.stdout[:14000], end="" if result.stdout.endswith("\n") else "\n")
    if result.returncode and result.stderr:
        print(result.stderr[:1000], file=sys.stderr)
    return result.returncode


if __name__ == "__main__":
    raise SystemExit(main())
